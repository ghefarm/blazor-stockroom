@page "/Account/PasswordChangeRequired"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject UserAccountService Accounts
@inject IdentityRedirectManager RedirectManager

<PageTitle>Choose a new password</PageTitle>

<h1>Choose a new password</h1>
<p>Your password was set by an administrator. Please choose your own
    password before you continue.</p>

<div class="row">
    <div class="col-xl-6">
        <EditForm EditContext="editContext"
                  FormName="required-password"
                  OnValidSubmit="ChangeAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText type="password" id="Input.Current"
                    @bind-Value="Input.Current" class="form-control"
                    autocomplete="current-password"
                    placeholder="password" />
                <label for="Input.Current">Current password</label>
                <ValidationMessage For="() => Input.Current"
                                   class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" id="Input.Next"
                    @bind-Value="Input.Next" class="form-control"
                    autocomplete="new-password"
                    placeholder="password" />
                <label for="Input.Next">New password</label>
                <ValidationMessage For="() => Input.Next"
                                   class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" id="Input.Repeat"
                    @bind-Value="Input.Repeat" class="form-control"
                    autocomplete="new-password"
                    placeholder="password" />
                <label for="Input.Repeat">
                    Repeat the new password
                </label>
                <ValidationMessage For="() => Input.Repeat"
                                   class="text-danger" />
            </div>
            <button type="submit"
                    class="w-100 btn btn-lg btn-primary">
                Save the new password
            </button>
        </EditForm>
    </div>
</div>

@code {
    private ApplicationUser? user;
    private EditContext editContext = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        editContext = new EditContext(Input);
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(
                UserManager, HttpContext);
        }
    }

    private async Task ChangeAsync()
    {
        var result = await Accounts.ChangePasswordAsync(
            user!, Input.Current, Input.Next);
        if (!result.Succeeded)
        {
            var messages = new ValidationMessageStore(editContext);
            messages.Add(() => Input.Next, result.Errors);
            editContext.NotifyValidationStateChanged();
            return;
        }

        // A new cookie, because the password change renewed the
        // security stamp.
        await SignInManager.RefreshSignInAsync(user!);
        RedirectManager.RedirectTo("");
    }

    private sealed class InputModel
    {
        [Required]
        public string Current { get; set; } = "";

        [Required]
        public string Next { get; set; } = "";

        [Compare(nameof(Next),
            ErrorMessage = "The two new passwords are not the same.")]
        public string Repeat { get; set; } = "";
    }
}
