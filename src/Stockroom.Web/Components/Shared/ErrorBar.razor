@* blazor.web.js looks for this id and shows the element when
   an unhandled exception has ended the circuit. *@
<div id="blazor-error-ui" data-nosnippet>
    Something went wrong, and this page has stopped working.
    <a href="." class="reload">Reload the page</a>
    <span class="dismiss" title="Close">x</span>
</div>
