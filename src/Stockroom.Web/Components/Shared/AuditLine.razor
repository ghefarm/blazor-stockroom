@inject BusinessClock Clock

<p class="text-muted small">
    Created @Format(Item.CreatedAt) by @Item.CreatedBy.
    @if (Item.LastModifiedAt is { } changedAt)
    {
        <text>
            Last changed @Format(changedAt)
            by @Item.LastModifiedBy.
        </text>
    }
</p>

@code {
    [Parameter, EditorRequired]
    public IAuditable Item { get; set; } = default!;

    // Stored as UTC, but read back with Kind Unspecified.
    private string Format(DateTime utc)
    {
        var time = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc), Clock.Zone);
        return BusinessFormats.FormatDateTime(time);
    }
}
