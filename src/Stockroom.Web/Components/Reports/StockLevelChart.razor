<div class="chart-box @(Compact ? "compact" : null)">
    <ApexChart TItem="LevelCount"
               Options="@options"
               Height="@("100%")">
        <ApexPointSeries TItem="LevelCount"
                         Items="@Levels"
                         Name="Products"
                         SeriesType="@SeriesType.Donut"
                         XValue="@(l => StockText.Describe(l.Level))"
                         YValue="@(l => l.Count)" />
    </ApexChart>
</div>

@code {
    private ApexChartOptions<LevelCount> options = new();

    [Parameter, EditorRequired]
    public IReadOnlyList<LevelCount> Levels { get; set; } = [];

    [Parameter]
    public bool IncludeInactive { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    protected override void OnParametersSet()
    {
        var subtitle = IncludeInactive
            ? "All products"
            : "Active products only";

        options = ChartOptions.Create<LevelCount>(
            "Products per stock level", subtitle, "stock-levels");
    }
}
