<table class="table">
    <thead>
        <tr>
            <th>Number</th>
            <th>Supplier</th>
            <th>Ordered on</th>
            <th>Status</th>
            <th class="text-end">Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Rows)
        {
            <tr>
                <td>@order.OrderNumber</td>
                <td>@order.SupplierName</td>
                <td>@BusinessFormats.FormatDate(order.OrderedOn)</td>
                <td>@order.Status</td>
                <td class="text-end">
                    @Money.Format(order.TotalCents)
                </td>
            </tr>
        }
        @if (Rows.Count == 0)
        {
            <tr>
                <td colspan="5">No orders match this filter.</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<OrderSummary> Rows { get; set; } = [];
}
