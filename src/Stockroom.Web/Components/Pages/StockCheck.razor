@page "/stock-check"
@attribute [Authorize(Roles = Roles.StockAreasOrAdmin)]
@rendermode InteractiveServer
@implements IDisposable
@inject StockCheckStatus Status
@inject IStockCheckRunner Runner

<PageTitle>Stock check</PageTitle>

<h1>Stock check</h1>

@{
    var state = Status.Current;
}

@if (state.IsRunning)
{
    <ProgressBar Label="Stock check" Percent="@state.Percent" />
    <button class="btn btn-outline-secondary mt-3"
            @onclick="Runner.Cancel">Cancel</button>
}
else
{
    <button class="btn btn-primary"
            @onclick="Start">Start the stock check</button>
}

@if (notice is not null)
{
    <p class="mt-3 text-danger">@notice</p>
}

@if (state.ResultText is not null)
{
    <p class="mt-3" role="status">@state.ResultText</p>
}

@code {
    private string? notice;

    protected override void OnInitialized() =>
        Status.Changed += HandleChanged;

    private void Start()
    {
        notice = Runner.TryStart()
            ? null
            : "A stock check is already in progress.";
    }

    // Raised on a thread pool thread, not on this circuit.
    private void HandleChanged(StockCheckState state) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= HandleChanged;
}
