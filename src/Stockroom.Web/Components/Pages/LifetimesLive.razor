@page "/lifetimes/live"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Lifetimes, live</PageTitle>

<h1>Lifetimes, Interactive Server</h1>

<p>Interactive: @RendererInfo.IsInteractive</p>

<table>
    <tr>
        <th></th>
        <th>Singleton</th>
        <th>Scoped</th>
        <th>Transient</th>
    </tr>
    @* A new key makes Blazor create new component instances. *@
    <MarkerRow @key="@($"first-{generation}")" Label="First" />
    <MarkerRow @key="@($"second-{generation}")" Label="Second" />
</table>

<button @onclick="ReplaceRows">Replace the rows</button>

@code {
    private int generation = 1;

    private void ReplaceRows()
    {
        generation++;
    }
}
