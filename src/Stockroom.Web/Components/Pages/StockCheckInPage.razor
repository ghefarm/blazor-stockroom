@page "/stock-check/in-page"
@attribute [Authorize(Roles = Roles.StockAreasOrAdmin)]
@rendermode InteractiveServer
@implements IDisposable
@inject IStockCheckWork Work

<PageTitle>Stock check (in the page)</PageTitle>

<h1>Stock check (in the page)</h1>

@if (running)
{
    <ProgressBar Label="Stock check" Percent="@percent" />
    <button class="btn btn-outline-secondary mt-3"
            @onclick="Cancel">Cancel</button>
}
else
{
    <button class="btn btn-primary"
            @onclick="StartAsync">Start the stock check</button>
}

@if (resultText is not null)
{
    <p class="mt-3" role="status">@resultText</p>
}

@code {
    private CancellationTokenSource? cancellation;
    private bool running;
    private int percent;
    private string? resultText;

    private async Task StartAsync()
    {
        // A second click can arrive before the first render.
        if (running)
        {
            return;
        }

        cancellation = new CancellationTokenSource();
        var token = cancellation.Token;
        running = true;
        percent = 0;
        resultText = null;

        // Created here, on the circuit: every report comes back
        // to the circuit, where StateHasChanged is allowed.
        var progress = new Progress<StockCheckProgress>(p =>
        {
            percent = p.Done * 100 / p.Total;
            StateHasChanged();
        });

        try
        {
            // The loop blocks its thread. On the thread pool, the
            // circuit stays free for a click on Cancel.
            var result = await Task.Run(
                () => Work.Run(progress, token));
            resultText = result.Describe();
        }
        catch (OperationCanceledException)
        {
            resultText = "The stock check was cancelled.";
        }
        finally
        {
            running = false;
            cancellation.Dispose();
            cancellation = null;
        }
    }

    private void Cancel() => cancellation?.Cancel();

    // Leaving the page ends the run: nobody could see or stop it.
    public void Dispose() => cancellation?.Cancel();
}
