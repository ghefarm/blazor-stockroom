@page "/products/{Id:int}"
@attribute [Authorize(Roles = Roles.StockAreasOrAdmin)]
@inject ProductCatalog Catalog
@inject NavigationManager Navigation

@if (product is not null)
{
    <PageTitle>@product.Name</PageTitle>

    <h1>@product.Name</h1>

    @if (notice is not null)
    {
        <Banner Notice="@notice" />
    }

    <dl class="row">
        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9">@product.Sku</dd>
        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Money.Format(product.PriceCents)</dd>
        <dt class="col-sm-3">Stock</dt>
        <dd class="col-sm-9">
            @product.StockQuantity
            <StockBadge Quantity="@product.StockQuantity" />
        </dd>
    </dl>

    <AuditLine Item="@product" />

    <p>
        <a href="products/@product.Id/label">Print a shelf label</a>
    </p>

    <p>
        <a href="products/@product.Id/count">Count the stock</a>
    </p>

    <p>
        <a href="products/@product.Id/price">Change the price</a>
    </p>
}

@code {
    private Product? product;
    private Notice? notice;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "done")]
    private string? Done { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        notice = ProductNotices.Find(Done);
        product = await Catalog.FindByIdAsync(Id);

        if (product is null)
        {
            Navigation.NotFound();
        }
    }
}
