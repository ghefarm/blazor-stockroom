@page "/products/{Id:int}/edit"
@attribute [Authorize(Roles = Roles.PurchasingOrAdmin)]
@using System.ComponentModel.DataAnnotations
@inject ProductCatalog Catalog
@inject NavigationManager Navigation

@if (product is not null)
{
    <PageTitle>Edit @product.Sku</PageTitle>

    <h1>Edit @product.Sku</h1>

    <EditForm Model="@Input" FormName="edit-product"
              OnValidSubmit="@Save" data-warn-unsaved>
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control"
                       @bind-Value="Input!.Name" />
            <ValidationMessage For="@(() => Input!.Name)" />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="products/@product.Id" class="ms-3">
            Back to the product
        </a>
        @if (next is not null)
        {
            <a href="products/@next.Id/edit" class="ms-3">
                Next product
            </a>
        }
    </EditForm>
}

@code {
    private Product? product;
    private Product? next;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    private ProductInput? Input { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        product = await Catalog.FindByIdAsync(Id);

        if (product is null)
        {
            Navigation.NotFound();
            return;
        }

        next = await Catalog.FindByIdAsync(Id + 1);

        // Fill from the product only when nothing was posted.
        Input ??= new() { Name = product.Name };
    }

    private async Task Save()
    {
        await Catalog.ChangeNameAsync(Id, Input!.Name);
        Navigation.NavigateTo($"products/{Id}");
    }

    private sealed class ProductInput
    {
        [Required, StringLength(80)]
        public string Name { get; set; } = "";
    }
}
