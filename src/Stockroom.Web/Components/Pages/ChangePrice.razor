@page "/products/{Id:int}/price"
@attribute [Authorize(Roles = Roles.PurchasingOrAdmin)]
@rendermode InteractiveServer
@inject ProductCatalog Catalog

<PageTitle>Change price</PageTitle>

@if (product is not null)
{
    <h1>@product.Name</h1>
    <p>Current price: @Money.Format(product.PriceCents)</p>
    <AuditLine Item="@product" />

    <label for="price">New price in cents</label>
    <input id="price" type="number" @bind="priceCents" />
    <button class="btn btn-primary" @onclick="SaveAsync">
        Save
    </button>
}

@code {
    private Product? product;
    private long priceCents;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        product = await Catalog.FindByIdAsync(Id);
        priceCents = product?.PriceCents ?? 0;
    }

    private async Task SaveAsync()
    {
        await Catalog.ChangePriceAsync(Id, priceCents);
        product = await Catalog.FindByIdAsync(Id);
    }
}
