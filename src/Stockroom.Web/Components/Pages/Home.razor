@page "/"
@using Stockroom.Core.Sample

<PageTitle>Stockroom</PageTitle>

<h1>Welcome to Stockroom</h1>

<p>Stockroom keeps track of products, suppliers and orders.</p>

<div class="tiles">
    <Tile Title="Products">
        <ChildContent>@products.Count</ChildContent>
        <Footer><a href="products">Open the list</a></Footer>
    </Tile>

    @foreach (var level in levels)
    {
        <Tile Title="@StockText.Describe(level)">
            @CountAt(level)
        </Tile>
    }
</div>

@code {
    private readonly IReadOnlyList<Product> products =
        SampleProducts.All;

    private readonly StockLevel[] levels =
        [StockLevel.Low, StockLevel.OutOfStock];

    private int CountAt(StockLevel level) =>
        StockRules.FilterByLevel(products, level).Count;
}
