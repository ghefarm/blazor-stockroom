@page "/"
@attribute [Authorize]
@inject ProductCatalog Catalog
@inject PurchaseOrderService Orders

<PageTitle>Stockroom</PageTitle>

<h1>Welcome to Stockroom</h1>

<p>Stockroom keeps track of products, suppliers and orders.</p>

<div class="tile-grid">
    <AuthorizeView Roles="@Roles.StockAreasOrAdmin">
        <Tile Title="Products">
            <ChildContent>@products.Count</ChildContent>
            <Footer><a href="products">Open the list</a></Footer>
        </Tile>

        @foreach (var level in levels)
        {
            <Tile Title="@StockText.Describe(level)">
                <ChildContent>@CountAt(level)</ChildContent>
                <Footer>
                    <a href="@StockQuery.CreateLink(level)">
                        Show them
                    </a>
                </Footer>
            </Tile>
        }
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.PurchasingOrAdmin">
        <Tile Title="Open orders">
            <ChildContent>@openOrders</ChildContent>
            <Footer><a href="orders">Show the orders</a></Footer>
        </Tile>
    </AuthorizeView>
</div>

@code {
    private IReadOnlyList<Product> products = [];
    private int openOrders;

    private readonly StockLevel[] levels =
        [StockLevel.Low, StockLevel.OutOfStock];

    protected override async Task OnInitializedAsync()
    {
        // Two services, two contexts: the queries can overlap.
        var productsTask = Catalog.GetAllAsync();
        var openTask = Orders.CountOpenAsync();
        await Task.WhenAll(productsTask, openTask);

        products = productsTask.Result;
        openOrders = openTask.Result;
    }

    private int CountAt(StockLevel level) =>
        StockRules.FilterByLevel(products, level).Count;
}
