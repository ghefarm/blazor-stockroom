@page "/products"
@rendermode InteractiveServer
@inject ProductCatalog Catalog
@inject NavigationManager Navigation

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<p><a href="products/reorder">Plan a reorder</a></p>

<StockTabs Selected="@selected" OnSelect="@SelectLevel" />

<table class="table">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Name</th>
            <th class="text-end">Price</th>
            <th class="text-end">Quantity</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in shown)
        {
            <ProductRow Product="@product" />
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<Product> all = [];
    private StockLevel? selected;
    private IReadOnlyList<Product> shown = [];
    private bool loaded;

    [SupplyParameterFromQuery(Name = StockQuery.Name)]
    private string? Stock { get; set; }

    protected override async Task OnInitializedAsync()
    {
        all = await Catalog.GetAllAsync();
    }

    protected override void OnParametersSet()
    {
        var level = StockQuery.Parse(Stock);

        // Reload only when the address asks for a different list.
        if (loaded && level == selected)
        {
            return;
        }

        ApplyFilter(level);
    }

    private void SelectLevel(StockLevel? level)
    {
        // Set the field first, so OnParametersSet sees no change.
        ApplyFilter(level);

        var uri = Navigation.GetUriWithQueryParameter(
            StockQuery.Name, StockQuery.Format(level));
        Navigation.NavigateTo(uri, replace: true);
    }

    private void ApplyFilter(StockLevel? level)
    {
        selected = level;
        shown = StockRules.FilterByLevel(all, level);
        loaded = true;
    }
}
