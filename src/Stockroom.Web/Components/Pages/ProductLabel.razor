@page "/products/{Id:int}/label"
@attribute [Authorize(Roles = Roles.StockAreasOrAdmin)]
@layout PrintLayout
@inject ProductCatalog Catalog
@inject NavigationManager Navigation

@if (product is not null)
{
    <PageTitle>Label @product.Sku</PageTitle>

    <div class="shelf-label">
        <div class="sku">@product.Sku</div>
        <div>@product.Name</div>
        <div class="price">@Money.Format(product.PriceCents)</div>
    </div>

    <p class="print-hint">Press Ctrl+P to print this label.</p>
}

@code {
    private Product? product;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        product = await Catalog.FindByIdAsync(Id);

        if (product is null)
        {
            Navigation.NotFound();
        }
    }
}
