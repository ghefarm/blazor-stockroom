<script type="module"
    src="@Assets["Components/Layout/ReconnectModal.razor.js"]">
</script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation"
             aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            The connection was lost. Reconnecting...
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Still trying. Seconds until the next attempt:
            <span id="components-seconds-to-next-attempt"></span>
        </p>
        <p class="components-reconnect-failed-visible">
            Could not reconnect.<br />
            Try again, or reload the page.
        </p>
        <button id="components-reconnect-button"
                class="components-reconnect-failed-visible">
            Try again
        </button>
        <p class="components-pause-visible">
            This page was paused to save server memory.
        </p>
        <p class="components-resume-failed-visible">
            Could not continue where you left off.<br />
            Try again, or reload the page.
        </p>
        <button id="components-resume-button"
                class="components-pause-visible
                       components-resume-failed-visible">
            Continue
        </button>
    </div>
</dialog>
