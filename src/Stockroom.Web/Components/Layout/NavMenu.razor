@using System.Security.Claims
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Stockroom</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @* Comfort only: the pages protect themselves. *@
        <AuthorizeView Roles="@Roles.StockAreasOrAdmin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="products">
                    <span class="bi bi-list-nested-nav-menu"
                          aria-hidden="true"></span> Products
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.PurchasingOrAdmin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="suppliers">
                    <span class="bi bi-list-nested-nav-menu"
                          aria-hidden="true"></span> Suppliers
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.PurchasingOrAdmin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="orders">
                    <span class="bi bi-list-nested-nav-menu"
                          aria-hidden="true"></span> Orders
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/users">
                    <span class="bi bi-lock-nav-menu"
                          aria-hidden="true"></span> Users
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="@($"users/{UserId(context)}")">
                        <span class="bi bi-person-fill-nav-menu"
                              aria-hidden="true"></span>
                        @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl"
                               value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span aria-hidden="true"
                                class="bi bi-arrow-bar-left-nav-menu">
                            </span> Sign out
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu"
                              aria-hidden="true"></span> Sign in
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    private static string? UserId(AuthenticationState state) =>
        state.User.FindFirstValue(ClaimTypes.NameIdentifier);

    // The menu is static: it renders again for every page.
    protected override void OnInitialized()
    {
        currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
    }
}

