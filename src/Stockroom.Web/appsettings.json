{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": {
      "File": {
        "Name": "File",
        "Args": {
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Stockroom": {
    "BusinessTimeZone": "America/Chicago",
    "SupportEmail": "it-desk@example.com"
  },
  "StockCheck": {
    "UseQueue": true
  },
  "Questions": {
    "Enabled": false,
    "Endpoint": "http://localhost:8080/v1",
    "Model": "name-of-your-model"
  },
  "Maintenance": {
    "Enabled": false,
    "Message": "Stockroom is being updated. Please come back later."
  }
}
