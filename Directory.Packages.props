<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Released with every .NET servicing update. They must
         all have the same version, so they share this value. -->
    <DotNetServicingVersion>10.0.15</DotNetServicingVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite"
                    Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design"
                    Version="$(DotNetServicingVersion)" />
    <PackageVersion
      Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore"
      Version="$(DotNetServicingVersion)" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <PackageVersion Include="Blazor-ApexCharts" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Files">
    <!-- Both MIT licensed. -->
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- PDFsharp brings 8.0.1, which has known vulnerabilities. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs"
                    Version="$(DotNetServicingVersion)" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk"
                    Version="17.14.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion
      Include="Microsoft.Extensions.TimeProvider.Testing"
      Version="10.0.0" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>
</Project>
